# scripts/setup.sh creates .env with generated secrets. Never commit .env.
ADMIN_API_KEY=GENERATE_WITH_SETUP
DEPOSIT_API_KEY=GENERATE_WITH_SETUP
OUTBOX_ENCRYPTION_KEY=GENERATE_WITH_SETUP
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000
LIVE_SALES=false
OPERATIONS_REVIEWED=false
PRODUCT_SHA256=
MAIL_MODE=mock
WORKER_ENABLED=true
PRICE_KRW=3000
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=support@example.com
BANK_ACCOUNT=모의 운영 — 실제 송금하지 마세요
BANK_HOLDER=미설정
PRODUCT_VERSION=출시 준비 중
SUPPORTED_KEYBOARDS=실제 지원 목록 확인 필요
# Absolute paths may be set. Defaults are relative to this source checkout.
# DATABASE_PATH=/absolute/project/var/store.sqlite3
